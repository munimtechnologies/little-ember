{
  "viewport": {"width": 1280, "height": 720},
  "boot_ms": 7000,
  "steps": [
    {"wait_for": "window.__ember && window.__ember.frames > 30", "timeout_ms": 30000},
    {"eval": "window.__ember.state", "expect": "title"},
    {"eval": "[window.__ember.flameW, window.__ember.flameH]", "expect": [100, 130]},
    {"eval": "window.__ember.errors", "expect": []},
    {"wait": 2500},
    {"shot": "title"},
    {"eval": "(window.__ember.seed = 4242, window.__ember.speed = 6, 1)"},
    {"click": [640, 420]},
    {"wait_for": "window.__ember.state === 'play'", "timeout_ms": 5000},
    {"eval": "window.__ember.music", "expect": "night.wav"},
    {"wait_for": "window.__ember.t > 1.5", "timeout_ms": 15000},
    {"eval": "(window.__ember.reqTwig = [300, 620], 1)"},
    {"wait_for": "window.__ember.reqTwig === null", "timeout_ms": 5000},
    {"wait": 400},
    {"click": [300, 620]},
    {"wait_for": "window.__ember.fed >= 1", "timeout_ms": 10000},
    {"eval": "window.__ember.lastClick", "save": "last_click"},
    {"eval": "({t: Math.round(window.__ember.t * 10) / 10, frames: window.__ember.frames, subSteps: window.__ember.subSteps})", "save": "speed_probe"},
    {"shot": "early"},
    {"eval": "(window.__ember.bot = 170, 1)"},
    {"wait_for": "window.__ember.t > 24 || window.__ember.state !== 'play'", "timeout_ms": 90000},
    {"eval": "(window.__ember.bot = 0, 1)"},
    {"wait_for": "window.__ember.t > 27.5 || window.__ember.state !== 'play'", "timeout_ms": 20000},
    {"shot": "play-25s"},
    {"eval": "(window.__ember.bot = 170, 1)"},
    {"wait_for": "window.__ember.t > 50 || window.__ember.state !== 'play'", "timeout_ms": 90000},
    {"eval": "(window.__ember.bot = 0, 1)"},
    {"wait_for": "window.__ember.t > 53.5 || window.__ember.state !== 'play'", "timeout_ms": 20000},
    {"shot": "play-50s"},
    {"eval": "(window.__ember.bot = 170, 1)"},
    {"wait_for": "window.__ember.t > 76 || window.__ember.state !== 'play'", "timeout_ms": 90000},
    {"eval": "window.__ember.music", "expect": "storm.wav"},
    {"eval": "(window.__ember.bot = 0, 1)"},
    {"wait_for": "window.__ember.t > 79.5 || window.__ember.state !== 'play'", "timeout_ms": 20000},
    {"shot": "play-80s"},
    {"eval": "(window.__ember.bot = 170, 1)"},
    {"wait_for": "window.__ember.t > 112 || window.__ember.state !== 'play'", "timeout_ms": 120000},
    {"eval": "(window.__ember.bot = 0, 1)"},
    {"wait_for": "window.__ember.t > 115.5 || window.__ember.state !== 'play'", "timeout_ms": 20000},
    {"shot": "play-115s"},
    {"eval": "(window.__ember.bot = 170, 1)"},
    {"wait_for": "window.__ember.state === 'won' || window.__ember.state === 'lost'", "timeout_ms": 240000},
    {"eval": "({state: window.__ember.state, t: Math.round(window.__ember.t), score: window.__ember.score, pops: window.__ember.pops, fed: window.__ember.fed, clumps: window.__ember.clumpsBroken, gusts: window.__ember.gustsBroken, hits: window.__ember.hits, minFire: Math.round(window.__ember.minFire), fire: Math.round(window.__ember.fire), botClicks: window.__ember.botClicks, frames: window.__ember.frames, sounds: window.__ember.sounds})", "save": "fast_bot_run"},
    {"eval": "window.__ember.state", "expect": "won"},
    {"wait": 2500},
    {"shot": "won"},
    {"eval": "window.__ember.score", "expect": {"gt": 1500}},
    {"eval": "window.__ember.clumpsBroken + window.__ember.gustsBroken", "expect": {"gte": 3}},
    {"eval": "window.__ember.nSnow + window.__ember.nClump + window.__ember.nGust + window.__ember.nTwig", "expect": 0},
    {"eval": "window.__ember.errors", "expect": []},
    {"click": [640, 420]},
    {"wait_for": "window.__ember.state === 'play' && window.__ember.starts === 2", "timeout_ms": 8000},
    {"eval": "window.__ember.nSnow + window.__ember.nClump + window.__ember.nGust", "expect": 0},
    {"wait": 1000},
    {"shot": "restart"},
    {"eval": "window.__ember.errors", "expect": []}
  ]
}
