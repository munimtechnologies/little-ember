{
  "viewport": {"width": 844, "height": 390},
  "touch": true,
  "boot_ms": 7000,
  "steps": [
    {"wait_for": "window.__ember && window.__ember.frames > 30", "timeout_ms": 30000},
    {"eval": "(() => { const r = document.querySelector('canvas').getBoundingClientRect(); return [Math.round(r.left), Math.round(r.top), Math.round(r.width), Math.round(r.height)]; })()", "save": "canvas_rect"},
    {"wait": 1500},
    {"shot": "title"},
    {"eval": "(window.__ember.seed = 777, window.__ember.speed = 6, 1)"},
    {"tap": [422, 195]},
    {"wait_for": "window.__ember.state === 'play'", "timeout_ms": 5000},
    {"wait_for": "window.__ember.t > 1.5", "timeout_ms": 15000},
    {"eval": "(() => { const r = document.querySelector('canvas').getBoundingClientRect(); const sx = (300 - r.left) * 1280 / r.width, sy = (300 - r.top) * 720 / r.height; window.__ember.reqTwig = [sx, sy]; return [Math.round(sx), Math.round(sy)]; })()", "save": "twig_scene_xy"},
    {"wait_for": "window.__ember.reqTwig === null", "timeout_ms": 5000},
    {"wait": 400},
    {"tap": [300, 300]},
    {"wait_for": "window.__ember.fed >= 1", "timeout_ms": 10000},
    {"eval": "window.__ember.lastClick", "save": "last_tap"},
    {"shot": "early"},
    {"eval": "(window.__ember.bot = 650, window.__ember.botErr = 18, 1)"},
    {"wait_for": "window.__ember.t > 60 || window.__ember.state !== 'play'", "timeout_ms": 200000},
    {"shot": "slow-60s"},
    {"wait_for": "window.__ember.state === 'won' || window.__ember.state === 'lost'", "timeout_ms": 300000},
    {"eval": "({state: window.__ember.state, t: Math.round(window.__ember.t), score: window.__ember.score, pops: window.__ember.pops, fed: window.__ember.fed, clumps: window.__ember.clumpsBroken, gusts: window.__ember.gustsBroken, hits: window.__ember.hits, minFire: Math.round(window.__ember.minFire), botClicks: window.__ember.botClicks, lostAt: window.__ember.lostAt})", "save": "slow_bot_run"},
    {"eval": "['won', 'lost'].includes(window.__ember.state)", "expect": true},
    {"eval": "window.__ember.state === 'won' || window.__ember.t > 90", "expect": true},
    {"wait": 2000},
    {"shot": "slow-end"},
    {"eval": "(window.__ember.bot = 0, 1)"},
    {"tap": [422, 195]},
    {"wait_for": "window.__ember.state === 'play' && window.__ember.starts === 2", "timeout_ms": 8000},
    {"wait_for": "window.__ember.state === 'lost'", "timeout_ms": 200000},
    {"eval": "window.__ember.lostAt", "save": "idle_lost_at"},
    {"eval": "Math.round(window.__ember.t)", "save": "idle_seconds", "expect": {"between": [15, 90]}},
    {"wait": 2000},
    {"shot": "lost"},
    {"eval": "window.__ember.nSnow + window.__ember.nClump + window.__ember.nGust + window.__ember.nTwig", "expect": 0},
    {"eval": "window.__ember.errors", "expect": []}
  ]
}
